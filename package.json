{
  "name": "byok-assistant",
  "version": "1.0.0",
  "description": "Bring-your-own-key, no-backend browser chat UI for the OpenAI and Anthropic APIs.",
  "type": "module",
  "main": "src/index.html",
  "scripts": {
    "start": "webpack serve --mode development",
    "dev": "webpack serve --mode development",
    "build": "webpack --mode production --env version=$(./get-version.sh)",
    "build:dev": "webpack --mode development --env version=$(./get-version.sh)",
    "test": "node --test"
  },
  "keywords": [
    "chatgpt",
    "claude",
    "openai",
    "anthropic",
    "pwa"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.7.3",
    "html-webpack-plugin": "^5.5.0",
    "mini-css-extract-plugin": "^2.7.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  },
  "dependencies": {
    "dompurify": "^3.0.1",
    "html2canvas": "^1.4.1",
    "marked": "^4.2.12",
    "workbox-webpack-plugin": "^6.5.4"
  }
}
