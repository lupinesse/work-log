{
  "name": "worklog",
  "version": "1.9.0",
  "description": "ADHD-friendly work tracker — single HTML file, runs locally in your browser.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node build.js && vite build",
    "portable": "node build.js && node build-portable.js",
    "portable:deploy": "node build.js && node build-portable.js && node deploy-portable.js",
    "preview": "vite preview --port 8080",
    "test:unit": "node test/unit.mjs",
    "test:scripts": "node --test \".github/scripts/test/*.test.mjs\"",
    "test": "node test/unit.mjs && node smoke-tests.cjs && node .github/scripts/test/ci-scripts.test.mjs",
    "lint": "eslint src/js/ *.js *.cjs \"test/**/*.mjs\" \".github/scripts/**/*.mjs\" && stylelint \"src/css/**/*.scss\"",
    "lint:css": "stylelint \"src/css/**/*.scss\"",
    "format": "prettier --write \"src/**/*\" \"*.js\" \"*.cjs\" \"test/**/*.{cjs,mjs}\" \".github/scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*\" \"*.js\" \"*.cjs\" \"test/**/*.{cjs,mjs}\" \".github/scripts/**/*.mjs\"",
    "prepare": "husky",
    "docs": "jsdoc -c jsdoc.config.json",
    "clean-branches": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/clean-branches.ps1"
  },
  "lint-staged": {
    "src/js/*.js": [
      "eslint",
      "prettier --write"
    ],
    "*.{js,cjs}": [
      "eslint",
      "prettier --write"
    ],
    "src/css/*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "test/**/*.mjs": [
      "eslint",
      "prettier --write"
    ],
    ".github/scripts/**/*.mjs": [
      "eslint",
      "prettier --write"
    ]
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": "9.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdoc": "^4.0.5",
    "lint-staged": "^17.0.8",
    "playwright": "^1.61.1",
    "prettier": "^3.8.4",
    "sass": "^1.101.0",
    "stylelint": "^17.13.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "vite": "^8.1.3"
  }
}
