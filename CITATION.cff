cff-version: 1.2.0
message: "If you use or adapt this software, please cite it using the metadata below."
title: "Work Log — ADHD-friendly time tracker"
version: 1.8.0
date-released: "2026-05-25"
url: "https://github.com/lupinesse/worklog"
repository-code: "https://github.com/lupinesse/worklog"
license: MIT
abstract: >
  A single-file, local-first browser application for tracking work time,
  managing daily tasks, integrating with Outlook calendar via COM interop,
  and syncing task metadata to Notion. Designed with ADHD-friendly features
  such as automated break reminders, focus mode, distraction capture,
  three-state checkpoints, and an "I don't know what to do" random task picker.
authors:
  - name: "Jenni Järvinen"
    email: jenni.jaervinen@iki.fi

# This project was developed using AI pair programming.
# Claude (Anthropic) acted as an AI collaborator throughout development:
# reviewing code, writing tests, refactoring modules, fixing bugs, and
# improving documentation — always with the human author directing and
# approving every change.
contributors:
  - name: "Claude Sonnet 4.6 (Anthropic)"
    website: "https://www.anthropic.com"
    role: "AI pair programmer — code review, test authoring, refactoring, documentation"
keywords:
  - time-tracking
  - productivity
  - ADHD
  - task-management
  - single-page-application
  - pomodoro
  - outlook-integration
  - notion-integration
