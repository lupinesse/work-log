{
  // Dev container for Assistant — a reproducible Node 22 environment with
  // dependencies pre-installed and the dev server / tests ready to run.
  //
  //   npm run dev    # webpack dev server at http://localhost:8080
  //   npm test       # unit tests (node --test)
  //   npm run build  # static production bundle in dist/

  "name": "Assistant",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",

  "postCreateCommand": "npm install",

  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Dev server", "onAutoForward": "notify" }
  },

  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  },

  "remoteUser": "node"
}
