{
  "source": {
    "include": ["src/js"],
    "includePattern": "\\.js$"
  },
  "opts": {
    "destination": "docs/",
    "recurse": true,
    "readme": "README.md"
  },
  "plugins": ["plugins/markdown"],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": false,
    "default": {
      "outputSourceFiles": true,
      "includeDate": false
    }
  }
}
